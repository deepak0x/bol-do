# --- Twilio (required for real calls) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=        # E.164 format, e.g. +15551234567

# --- STT (Deepgram) ---
DEEPGRAM_API_KEY=

# --- LLM (Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- TTS ---
# Pick one of: silk1 | cartesia
TTS_PROVIDER=silk1

# Silk 1 (Rumik) — primary TTS
SILK1_API_KEY=
SILK1_API_BASE=https://silk-api.rumik.ai
SILK1_MODEL=muga                           # muga (low latency) | mulberry (expressive)
SILK1_TONE=                                # muga: neutral|happy|sad|excited|angry|whisper (blank = auto from call tone)
# mulberry-only knobs:
SILK1_DESCRIPTION=                         # e.g. "warm female narrator, Indian English"
SILK1_SPEAKER=                             # speaker_1 .. speaker_4
SILK1_F0_UP_KEY=0                          # pitch shift in semitones (-12..12)

# Cartesia (fallback only)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=71a7ad14-091c-4e8e-a314-022ece01c121

# --- Server ---
PORT=7860
LOCAL_SERVER_URL=          # e.g. https://abcd-1234.ngrok.io  (run ngrok, paste here)

# --- End-of-call behaviour ---
SILENCE_NUDGE_SEC=10
SILENCE_TIMEOUT_SEC=30
GOODBYE_DELAY_SEC=2
MIN_TURNS_BEFORE_HANGUP=2

# --- SMTP (Gmail app password) for call reports ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TO=                                  # defaults to SMTP_USER when blank
